[Script]
http-response ^https?:\/\/x\.com\/i\/api\/graphql\/[^\/]+\/(HomeTimeline|HomeLatestTimeline|TweetDetail) script-path=https://raw.githubusercontent.com/5jwoj/Surge/main/X/X_ads.js, requires-body=true, timeout=10, tag=X网页版去广告

[MITM]
hostname = x.com
